# Скопируйте в .env и заполните значения.
# В продакшене обязательно задайте SECRET_KEY и DEBUG=0.

# Секретный ключ Django (сгенерируйте свой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your-secret-key-here

# Режим отладки: True для разработки, False для продакшена
DJANGO_DEBUG=True

# Разрешённые хосты через запятую (для продакшена: yourdomain.com,www.yourdomain.com)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ключ для AI-помощника по урокам (Gemini). Получить: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Ключ для Groq AI
# GROQ_API_KEY=your-groq-api-key

# На Render обычно задаётся автоматически (хост без https, напр. devlearn-xxx.onrender.com).
# Нужен для ALLOWED_HOSTS, CSRF и корректного HTTPS за прокси.
# RENDER_EXTERNAL_HOSTNAME=

# Дополнительные доверенные origin для CSRF через запятую (если нужен свой домен):
# CSRF_TRUSTED_ORIGINS=https://example.com

# Cloudinary для хранения изображений
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Доступ и Stripe ---
# Публичный сайт (Render / портфолио): все уроки бесплатно после входа — оставьте True или не задавайте.
# Для демо Stripe только локально: FREE_PUBLIC_ACCESS=False + ключи ниже.
FREE_PUBLIC_ACCESS=True

# Локальное демо Stripe Checkout (Test mode в dashboard.stripe.com):
# 1) Установите FREE_PUBLIC_ACCESS=False
# 2) Раскомментируйте и заполните тестовые ключи (sk_test_..., price_... из Test mode)
# 3) python manage.py runserver → страница оплаты → карта 4242 4242 4242 4242, любая дата в будущем, CVC 123
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# Webhook для локалки опционален; на Render для выдачи доступа после оплаты — STRIPE_WEBHOOK_SECRET
# STRIPE_WEBHOOK_SECRET=whsec_...
# BUNDLE_PRICE_USD=4

# --- Google Analytics 4 (опционально) ---
# В Google Analytics: Admin → Data streams → выбрать поток → Measurement ID (G-…).
# На Render добавьте ту же переменную в Environment. Здесь не коммитьте реальный ID.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
